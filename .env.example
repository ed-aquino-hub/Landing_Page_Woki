# Valor del atributo content para verificar el dominio en Google Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Dominio canónico opcional. Si queda vacío, el proyecto usa https://woki.pe.
PUBLIC_SITE_URL=

# Bloqueo manual. En Vercel también se activa automáticamente en previews y mientras
# VERCEL_PROJECT_PRODUCTION_URL termine en .vercel.app.
PUBLIC_NOINDEX=

# URL de la ficha de Woki en Google Play; déjalo vacío hasta que esté publicada.
PUBLIC_GOOGLE_PLAY_URL=

# Claves de Cloudflare Turnstile para el CAPTCHA. La pública se incluye al compilar.
PUBLIC_TURNSTILE_SITE_KEY=

# Configura estos secretos en el entorno del contenedor; nunca se incluyen en el cliente.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL del Cloudflare Worker del Libro de Reclamaciones (ver docs/libro-reclamaciones.md).
# Vacío: la página explica que el libro aún no recibe hojas en línea y desactiva el envío.
PUBLIC_COMPLAINTS_ENDPOINT=

# Docker Compose: puerto HTTP del VPS (usa 80 si está libre).
HTTP_PORT=8080
# Usa 127.0.0.1 cuando Nginx/Caddy del VPS actúe como proxy inverso.
BIND_ADDRESS=0.0.0.0
