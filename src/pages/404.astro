---
import Layout from '../layouts/Layout.astro';
import Taxi from '../components/Taxi.astro';
import TowTruck from '../components/TowTruck.astro';
import { brand } from '../data/site';
import '../styles/pages.css';
import '../styles/404.css';
---
<Layout title="Página no disponible | Woki" description="No pudimos cargar esta página de Woki. Prueba otra vez en un momento.">
  <main id="main-content" class="page nf-page">
    <section class="nf-screen" aria-labelledby="nf-title">
      <div class="wrap nf-content">
        <p class="nf-kicker">Woki · Página no disponible</p>
        <p class="nf-code" aria-hidden="true">404</p>
        <h1 id="nf-title">No pudimos cargar esta página.</h1>
        <p class="nf-copy">Puede que la dirección no exista o que haya un problema temporal. Prueba otra vez en un momento.</p>
        <div class="nf-actions">
          <button class="p-btn p-btn-aqua" type="button" data-retry-page>Probar de nuevo</button>
          <a class="p-btn p-btn-ghost" href={`mailto:${brand.email}?subject=${encodeURIComponent('Ayuda con la página de Woki')}`}>Contactar a soporte</a>
        </div>
        <div class="nf-tow-scene" aria-hidden="true">
          <div class="nf-tow-rig">
            <div class="nf-towed-taxi"><Taxi /></div>
            <div class="nf-tow-vehicle"><TowTruck /></div>
          </div>
          <div class="road nf-road"></div>
        </div>
      </div>
    </section>
  </main>
  <script>
    document.querySelector<HTMLButtonElement>('[data-retry-page]')?.addEventListener('click', () => window.location.reload());
  </script>
</Layout>
