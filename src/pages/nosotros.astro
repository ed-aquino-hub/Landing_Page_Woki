---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageCta from '../components/PageCta.astro';
import AboutHero from '../components/nosotros/AboutHero.astro';
import AboutPurpose from '../components/nosotros/AboutPurpose.astro';
import AboutValues from '../components/nosotros/AboutValues.astro';
import AboutPrinciples from '../components/nosotros/AboutPrinciples.astro';
import { buildJsonLd } from '../data/content';
import { aboutPage as page } from '../data/pages';
import { assets } from '../data/site';
import '../styles/pages.css';
import '../styles/nosotros.css';

const structuredData = buildJsonLd(Astro.site, 'about');
---
<Layout title={page.title} description={page.description} image={assets.aboutBanner} imageAlt="Banner de Woki y su propuesta de movilidad local en Cerro de Pasco" ogType="website">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content" class="page">
    <AboutHero />
    <AboutPurpose />
    <AboutValues />
    <AboutPrinciples />
    <PageCta titleLead={page.cta.title} actions={page.cta.actions} location="nosotros_cta_final" store />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
