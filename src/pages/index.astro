---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import AudienceCards from '../components/home/AudienceCards.astro';
import SafetyStages from '../components/home/SafetyStages.astro';
import RideSteps from '../components/home/RideSteps.astro';
import DriverPlans from '../components/home/DriverPlans.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import DownloadCta from '../components/home/DownloadCta.astro';
import { buildJsonLd } from '../data/content';
import '../styles/home.css';

const jsonLd = buildJsonLd(Astro.site);
---
<Layout splash>
  {jsonLd.map((j) => <script is:inline type="application/ld+json" set:html={JSON.stringify(j)} slot="head" />)}

  <Header />

  <main id="main-content" class="home">
    <HomeHero />
    <AudienceCards />
    <SafetyStages />
    <RideSteps />
    <DriverPlans />
    <HomeFaq />
    <DownloadCta />
  </main>

  <Footer />

  <script>import '../scripts/main.ts';</script>
</Layout>
