---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageFaq from '../components/PageFaq.astro';
import PageCta from '../components/PageCta.astro';
import SafetyHero from '../components/seguridad/SafetyHero.astro';
import SafetyJourney from '../components/seguridad/SafetyJourney.astro';
import SafetyTools from '../components/seguridad/SafetyTools.astro';
import SafetyMismatch from '../components/seguridad/SafetyMismatch.astro';
import SafetyPayments from '../components/seguridad/SafetyPayments.astro';
import { buildFaqJsonLd, buildSectionJsonLd, passengerFaqs } from '../data/content';
import { safetyPage as page } from '../data/pages';
import { assets } from '../data/site';
import '../styles/pages.css';
import '../styles/seguridad.css';

const structuredData = [...buildSectionJsonLd(Astro.site, page.path, page.jsonLdName, page.description, page.crumb), buildFaqJsonLd(passengerFaqs)];
---
<Layout title={page.title} description={page.description} image={assets.socialImage} imageAlt="Herramientas de seguridad de Woki para viajes en taxi" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content" class="page">
    <SafetyHero />
    <PageNav items={page.nav} location="seguridad_en_esta_pagina" />
    <SafetyJourney />
    <SafetyTools />
    <SafetyMismatch />
    <SafetyPayments />
    <PageFaq {...page.faq} items={passengerFaqs} location="seguridad_faq" />
    <PageCta titleLead={page.cta.title} text={page.cta.text} actions={page.cta.actions} location="seguridad_cta_final" />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
