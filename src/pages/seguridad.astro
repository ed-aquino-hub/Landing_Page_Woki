---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrbitBadges from '../components/OrbitBadges.astro';
import TopographicBackdrop from '../components/TopographicBackdrop.astro';
import SectionJump from '../components/SectionJump.astro';
import JourneyRoute from '../components/JourneyRoute.astro';
import StopsList from '../components/StopsList.astro';
import FaqList from '../components/FaqList.astro';
import FinalDestination from '../components/FinalDestination.astro';
import { benefits, buildSectionJsonLd, passengerFaqs, passengerJourney, passengerJourneySubtitle, passengerJourneyTitle, passengerSafetyTools, passengerSituations, paymentOptions, passengerFinalDestination } from '../data/content';
import { assets, brand } from '../data/site';

const title = `Seguridad en tus viajes | Woki`;
const description = `Conoce las herramientas de seguridad para pedir taxi en Cerro de Pasco: conductor verificado, PIN y seguimiento. Revisa cómo te acompaña Woki.`;
const structuredData = buildSectionJsonLd(Astro.site, '/seguridad', 'Pasajero en Woki', description);
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: passengerFaqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
};
const sections = [
  { id: 'recorrido', label: 'Recorrido' },
  { id: 'seguridad-pasajero', label: 'Seguridad' },
  { id: 'casos', label: 'Situaciones' },
  { id: 'pago', label: 'Pago' },
  { id: 'dudas', label: 'Dudas' },
];
---
<Layout title={title} description={description} image={assets.socialImage} bannerImage={assets.contactBanner} imageAlt="Herramientas de seguridad de Woki para viajes en taxi" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} slot="head" />
  <Header solid />
  <main id="main-content">
    <section class="subpage-hero detail-hero safety-hero"><TopographicBackdrop city /><div class="wrap safety-hero-grid"><div class="safety-hero-copy"><p class="eyebrow">Confianza en cada recorrido</p><h1>Viaja con más tranquilidad</h1><p class="lead">Conoce las herramientas de Woki que ayudan a identificar el viaje, seguir el recorrido y mantener el contacto.</p><a class="btn solid safety-hero-cta" href="/#descargar">Viaja como pasajero</a></div><div class="safety-pin-stage"><OrbitBadges items={benefits}/><div class="safety-pin-panel" role="img" aria-label={`PIN de seguridad del viaje: ${brand.demoPin}`}><span>PIN de seguridad</span><strong aria-hidden="true">{[...brand.demoPin].map((digit,index)=><i style={`--digit-index:${index}`}>{digit}</i>)}</strong></div></div></div></section>
    <SectionJump items={sections} />
    <JourneyRoute id="recorrido" title={passengerJourneyTitle} subtitle={passengerJourneySubtitle} steps={passengerJourney} />
    <StopsList id="seguridad-pasajero" eyebrow="Herramientas para tu viaje" title="Tu seguridad, herramienta por herramienta" subtitle="Recursos para reconocer el servicio, coordinar el recorrido y compartir una referencia clara." items={passengerSafetyTools} balanced />
    <StopsList id="casos" eyebrow="En cada momento" title="Pensado para cada situación" subtitle="Información útil para que sepas qué revisar antes y durante el recorrido." items={passengerSituations} dark />
    <StopsList id="pago" eyebrow="Al llegar a destino" title="Pagar es simple" subtitle="Elige el medio que te resulte más cómodo y coordina los detalles antes de terminar el viaje." items={paymentOptions} featured />
    <FaqList id="dudas" items={passengerFaqs} subtitle="Respuestas sobre tus viajes como pasajero en Woki." />
    <FinalDestination {...passengerFinalDestination} />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>

<style>
  .safety-hero{position:relative;isolation:isolate;min-height:0;padding:7rem 0 2.75rem;overflow:hidden;background:linear-gradient(120deg,var(--deep),var(--ink))}
  .safety-hero>.wrap{position:relative;z-index:1;display:grid;width:min(calc(100% - 2.5rem),var(--max));grid-template-columns:minmax(0,1fr) minmax(320px,.85fr);align-items:center;gap:clamp(1.5rem,5vw,5rem);margin-inline:auto}
  .safety-hero-copy{max-width:620px}
  .safety-hero-copy .eyebrow{color:var(--aqua)}
  .safety-hero-copy h1{max-width:11ch;color:white;font-size:clamp(2.65rem,5.7vw,4.75rem);line-height:1.02;text-wrap:balance}
  .safety-hero-copy .lead{max-width:52ch;color:var(--paper);font-size:1.05rem;line-height:1.65}
  .safety-hero-cta{margin-top:.4rem}
  .safety-pin-stage{position:relative;display:grid;place-items:center;min-width:0;min-height:320px}
  .safety-pin-stage :global(.orbit-badges){--orbit-size:clamp(250px,29vw,370px);position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%)}
  .safety-pin-panel{position:relative;z-index:2;display:grid;justify-items:center;gap:.6rem;min-width:220px;padding:1.25rem 1.6rem;border:1px solid color-mix(in srgb,var(--aqua) 42%,transparent);border-radius:24px;background:color-mix(in srgb,var(--deep) 58%,transparent);color:white;box-shadow:0 24px 65px color-mix(in srgb,var(--ink) 36%,transparent);backdrop-filter:blur(16px)}
  .safety-pin-panel>span{color:var(--aqua);font-size:.76rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}
  .safety-pin-panel strong{display:flex;gap:.13em;color:white;font-size:clamp(3rem,6vw,5rem);font-weight:850;letter-spacing:.14em;line-height:1}
  .safety-pin-panel i{font-style:normal;animation:pin-digit-turn .68s cubic-bezier(.2,.85,.3,1.1) both;animation-delay:calc(var(--digit-index)*80ms);transform-origin:center}
  @keyframes pin-digit-turn{from{opacity:0;transform:perspective(200px) rotateX(-90deg) translateY(8px)}to{opacity:1;transform:perspective(200px) rotateX(0) translateY(0)}}
  @media(max-width:950px){.safety-hero{padding:7rem 0 2.5rem}.safety-hero>.wrap{grid-template-columns:1fr minmax(240px,.7fr)}.safety-pin-stage{min-height:290px}}
  @media(max-width:640px){.safety-hero{padding:6.5rem 0 2rem}.safety-hero>.wrap{grid-template-columns:1fr;gap:1rem}.safety-hero-copy h1{font-size:clamp(2.55rem,12vw,3.6rem)}.safety-hero-copy .lead{font-size:1rem}.safety-pin-stage{min-height:250px}.safety-pin-stage :global(.orbit-badges){--orbit-size:min(72vw,300px)}.safety-pin-panel{min-width:190px;padding:1rem 1.25rem}}
  @media(prefers-reduced-motion:reduce){.safety-pin-panel i{animation:none}}
</style>
