---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopographicBackdrop from '../components/TopographicBackdrop.astro';
import SectionJump from '../components/SectionJump.astro';
import JourneyRoute from '../components/JourneyRoute.astro';
import StopsList from '../components/StopsList.astro';
import RequirementsSteps from '../components/RequirementsSteps.astro';
import FaqList from '../components/FaqList.astro';
import FinalDestination from '../components/FinalDestination.astro';
import { buildSectionJsonLd, driverReasons, driverFaqs, driverJourney, driverJourneySubtitle, driverJourneyTitle, driverSafety, driverPaymentOptions, driverRequirements, driverFinalDestination } from '../data/content';
import { assets, brand } from '../data/site';

const title = `Conduce con Woki en ${brand.city}`;
const description = `Conduce taxi con Woki en Cerro de Pasco: revisa solicitudes, tarifas y actividad desde la app. Conoce los pasos para empezar.`;
const structuredData = buildSectionJsonLd(Astro.site, '/conductores', 'Conduce con Woki', description);
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: driverFaqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
};
const sections = [
  { id: 'recorrido', label: 'Recorrido' },
  { id: 'seguridad-conductor', label: 'Seguridad' },
  { id: 'ganancias', label: 'Ganancias' },
  { id: 'registro-conductor', label: 'Registro' },
  { id: 'local', label: 'Por qué Woki' },
  { id: 'dudas', label: 'Dudas' },
];
---
<Layout title={title} description={description} image={assets.driverPhoto} bannerImage={assets.driverPhoto} imageAlt="Conductor de taxi revisando sus viajes en la app de Woki" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} slot="head" />
  <Header solid />
  <main id="main-content">
    <section class="subpage-hero detail-hero driver-hero"><TopographicBackdrop city /><div class="wrap driver-hero-grid"><div class="driver-hero-copy"><p class="eyebrow">Para quienes conducen</p><h1>Conduce con Woki a tu manera</h1><p class="lead">Conoce las funciones que te ayudan a revisar cada solicitud y mantener a la vista la información de tus viajes.</p><a class="btn solid driver-hero-cta" href="#registro-conductor">Regístrate como conductor</a></div><div class="driver-hero-visual"><Picture src={assets.driverPhoto} formats={['avif', 'webp']} widths={[360, 540, 720, 960, 1200]} sizes="(min-width: 1000px) 46vw, 100vw" alt="Conductor de taxi en Cerro de Pasco" loading="eager" fetchpriority="high" decoding="async"/></div></div></section>
    <SectionJump items={sections} />
    <JourneyRoute id="recorrido" title={driverJourneyTitle} subtitle={driverJourneySubtitle} steps={driverJourney} />
    <StopsList id="seguridad-conductor" eyebrow="Un viaje claro para ambos" title="Tu seguridad como conductor" subtitle="Una secuencia de apoyo desde que te activas hasta que completas cada recorrido." items={driverSafety} dark sequence />
    <StopsList id="ganancias" eyebrow="Opciones para conductores" title="Elige cómo pagar por usar Woki" subtitle="Escoge el modelo que mejor encaje con la frecuencia con la que conduces." items={driverPaymentOptions} featured />
    <RequirementsSteps id="registro-conductor" data={driverRequirements} />
    <StopsList id="local" eyebrow="Una plataforma local" title="Por qué conducir con Woki" subtitle="Una propuesta cercana a la movilidad de Cerro de Pasco, creada para conectar conductores y pasajeros de la ciudad." items={driverReasons} />
    <FaqList id="dudas" items={driverFaqs} subtitle="Respuestas sobre el registro y la experiencia de conducir con Woki." />
    <FinalDestination {...driverFinalDestination} />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>

<style>
  .driver-hero{position:relative;isolation:isolate;min-height:0;padding:7rem 0 2.75rem;overflow:hidden;background:linear-gradient(125deg,var(--deep),var(--ink))}
  .driver-hero>.wrap{position:relative;z-index:1;display:grid;width:min(calc(100% - 2.5rem),var(--max));grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center;gap:clamp(2rem,6vw,6rem);margin-inline:auto}
  .driver-hero-copy{max-width:560px}
  .driver-hero-copy h1{max-width:12ch;color:#fff;font-size:clamp(2.45rem,4.5vw,3.8rem);line-height:1.02;text-wrap:balance}
  .driver-hero-copy .eyebrow{color:var(--aqua)}
  .driver-hero-copy .lead{max-width:50ch;color:var(--paper);font-size:1.1rem;line-height:1.65}
  .driver-hero-cta{margin-top:.35rem}
  .driver-hero-visual{position:relative;min-width:0;aspect-ratio:1.65;isolation:isolate}
  .driver-hero-visual::before{content:"";position:absolute;z-index:-1;inset:-7%;border:1px solid color-mix(in srgb,var(--aqua) 30%,transparent);border-radius:50%;box-shadow:0 0 0 20px color-mix(in srgb,var(--aqua) 5%,transparent),0 0 0 48px color-mix(in srgb,var(--aqua) 3%,transparent)}
  .driver-hero-visual picture,.driver-hero-visual img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center;border-radius:47% 53% 42% 58% / 46% 40% 60% 54%}
  .driver-hero-visual img{box-shadow:0 28px 72px color-mix(in srgb,var(--ink) 42%,transparent)}
  @media(max-width:950px){.driver-hero{padding:7rem 0 2.5rem}.driver-hero>.wrap{grid-template-columns:1fr minmax(0,.9fr);gap:1.5rem}.driver-hero-copy{max-width:700px}.driver-hero-visual{width:100%;margin-inline:auto;aspect-ratio:1.35}}
  @media(max-width:620px){.driver-hero{padding:6.5rem 0 2rem}.driver-hero>.wrap{width:calc(100% - 2rem);grid-template-columns:1fr;gap:1.4rem}.driver-hero-copy h1{font-size:clamp(2.5rem,12vw,3.5rem)}.driver-hero-copy .lead{font-size:1rem}.driver-hero-visual{aspect-ratio:1.3}.driver-hero-visual picture,.driver-hero-visual img{border-radius:30px;object-position:center 38%}}
</style>
