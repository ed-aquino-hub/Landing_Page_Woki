---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageFaq from '../components/PageFaq.astro';
import PageCta from '../components/PageCta.astro';
import DriverHero from '../components/conductores/DriverHero.astro';
import DriverDay from '../components/conductores/DriverDay.astro';
import DriverPlanCards from '../components/conductores/DriverPlanCards.astro';
import DriverRegister from '../components/conductores/DriverRegister.astro';
import DriverSafety from '../components/conductores/DriverSafety.astro';
import DriverStickyBar from '../components/conductores/DriverStickyBar.astro';
import { buildFaqJsonLd, buildSectionJsonLd, driverFaqs } from '../data/content';
import { driversPage as page } from '../data/pages';
import { assets } from '../data/site';
import '../styles/pages.css';
import '../styles/conductores.css';

const structuredData = [...buildSectionJsonLd(Astro.site, page.path, page.jsonLdName, page.description, page.crumb), buildFaqJsonLd(driverFaqs)];
---
<Layout title={page.title} description={page.description} image={assets.driverPhoto} imageAlt="Conductor de taxi revisando sus viajes en la app de Woki" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content" class="page">
    <DriverHero />
    <PageNav items={page.nav} location="conductores_en_esta_pagina" />
    <DriverDay />
    <DriverPlanCards />
    <DriverRegister />
    <DriverSafety />
    <PageFaq {...page.faq} items={driverFaqs} location="conductores_faq" tone="white" />
    <PageCta titleLead={page.cta.titleLead} titleAccent={page.cta.titleAccent} text={page.cta.text} actions={page.cta.actions} location="conductores_cta_final" tone="ink" store />
  </main>
  <DriverStickyBar />
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
