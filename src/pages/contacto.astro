---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import ContactHero from '../components/contacto/ContactHero.astro';
import { buildJsonLd } from '../data/content';
import { contactPage as page } from '../data/pages';
import { assets } from '../data/site';
import '../styles/pages.css';
import '../styles/contacto.css';

const structuredData = buildJsonLd(Astro.site, 'contact');
---
<Layout title={page.title} description={page.description} image={assets.contactBanner} imageAlt="Banner de contacto de Woki en Cerro de Pasco" ogType="website">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content" class="page">
    <ContactHero />
    <Contact />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
