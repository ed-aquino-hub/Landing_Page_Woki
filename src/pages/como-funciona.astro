---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HowHero from '../components/como-funciona/HowHero.astro';
import HowLanes from '../components/como-funciona/HowLanes.astro';
import HowGuides from '../components/como-funciona/HowGuides.astro';
import { buildSectionJsonLd } from '../data/content';
import { howItWorksPage as page } from '../data/pages';
import { assets } from '../data/site';
import '../styles/pages.css';
import '../styles/como-funciona.css';

const structuredData = buildSectionJsonLd(Astro.site, page.path, page.jsonLdName, page.description, page.crumb);
---
<Layout title={page.title} description={page.description} image={assets.socialImage} imageAlt="Recorrido de un viaje en Woki" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content" class="page">
    <HowHero />
    <HowLanes />
    <HowGuides />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
