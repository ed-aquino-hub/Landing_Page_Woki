---
import StoreButtons from './StoreButtons.astro';
interface Props { eyebrow: string; title: string; text: string; primaryLabel: string; primaryHref: string; secondaryLabel: string; secondaryHref: string }
const { eyebrow, title, text, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---
<section class="destination-section" aria-labelledby="destination-title">
  <div class="wrap"><div class="destination-card">
    <p class="eyebrow">{eyebrow}</p><h2 id="destination-title">{title}</h2><p class="destination-copy">{text}</p>
    <div class="destination-actions"><a class="btn destination-primary" href={primaryHref}>{primaryLabel}</a><a class="btn destination-secondary" href={secondaryHref}>{secondaryLabel}</a><StoreButtons /></div>
    <div class="destination-road" aria-hidden="true"><span></span><span></span><span></span></div>
  </div></div>
</section>

<style>
  .destination-section{padding:clamp(2.5rem,5vw,4rem) 0;background:#fff}
  .destination-card{position:relative;overflow:hidden;padding:clamp(1.5rem,5vw,3.5rem);border-radius:var(--r-lg);background:linear-gradient(120deg,var(--deep),var(--cian));color:white;text-align:center}
  .destination-card .eyebrow{justify-content:center;color:var(--aqua)}.destination-card h2{max-width:22ch;margin:.5rem auto;color:white;text-wrap:balance}.destination-copy{max-width:58ch;margin:0 auto;color:#e5f5f6;font-size:1.05rem}
  .destination-actions{position:relative;z-index:1;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.7rem;margin:1.3rem auto 1.5rem}.destination-primary,.destination-secondary{border-color:white;background:white;color:var(--deep)}.destination-secondary{background:transparent;color:white}.destination-card .store{background:#000}.destination-road{position:absolute;right:0;bottom:0;left:0;display:flex;justify-content:space-around;align-items:center;height:2.2rem;border-top:1px solid #ffffff24;background:color-mix(in srgb,var(--deep) 52%,transparent)}.destination-road::before{content:'';position:absolute;right:0;left:0;top:50%;border-top:2px dashed #fff9}.destination-road span{position:relative;z-index:1;width:.55rem;height:.55rem;border:2px solid white;border-radius:50%;background:var(--pin)}
  @media(max-width:600px){.destination-card{padding:1.5rem 1.1rem 3.5rem}.destination-actions{flex-direction:column;align-items:stretch}.destination-actions .btn,.destination-actions .store{justify-content:center}}
</style>
