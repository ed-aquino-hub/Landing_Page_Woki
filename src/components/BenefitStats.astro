---
interface StatItem {
  value: number;
  label: string;
  description: string;
}

interface Props {
  title: string;
  items: StatItem[];
}

const { title, items } = Astro.props;
---
<section class="benefit-stats-section" aria-label={title}>
  <div class="wrap">
    <header class="benefit-stats-heading" data-reveal>
      <p class="eyebrow dark">Woki, en resumen</p>
      <h2>{title}</h2>
    </header>
    <div class="benefit-stats-grid">
      {items.map((item, index) => (
        <article class="benefit-stat" data-reveal style={`--i:${index}`}>
          <strong><span data-count={item.value}>{item.value}</span></strong>
          <h3>{item.label}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .benefit-stats-section{position:relative;isolation:isolate;padding:clamp(2.5rem,5vw,4rem) 0;background:var(--paper)}
  .benefit-stats-heading{max-width:700px;margin:0 auto 1.5rem;text-align:center}
  .benefit-stats-heading .eyebrow{justify-content:center;margin-bottom:.55rem}
  .benefit-stats-heading h2{margin:0;color:var(--deep);font-size:clamp(1.5rem,2.6vw,2rem)}
  .benefit-stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .benefit-stat{min-height:180px;padding:1.2rem;border:1px solid color-mix(in srgb,var(--cian) 26%,white);border-top:3px solid var(--cian);border-radius:20px;background:#fff;box-shadow:0 14px 34px color-mix(in srgb,var(--deep) 8%,transparent);text-align:center}
  .benefit-stat>strong{display:block;margin-bottom:.35rem;color:var(--cian);font-size:clamp(2.25rem,4vw,3rem);font-weight:900;line-height:1}
  .benefit-stat h3{margin:.4rem 0;color:var(--deep);font-size:1rem}
  .benefit-stat p{max-width:30ch;margin:0 auto;color:#45666b;font-size:.9rem;line-height:1.5}
  @media(max-width:650px){.benefit-stats-grid{grid-template-columns:1fr}.benefit-stat{min-height:0;padding:1rem}}
</style>
