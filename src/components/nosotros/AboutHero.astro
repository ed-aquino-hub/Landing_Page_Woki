---
import Breadcrumbs from '../Breadcrumbs.astro';
import { companyPurpose } from '../../data/content';
import { aboutPage } from '../../data/pages';
const { hero } = aboutPage;
---
<section class="ab-hero" aria-labelledby="ab-hero-title">
  <div class="wrap">
    <Breadcrumbs current={aboutPage.crumb} />
    <div class="ab-hero-head">
      <div class="p-hero-copy">
        <p class="p-kicker">{hero.eyebrow}</p>
        <h1 id="ab-hero-title">{hero.titleLead} <span>{hero.titleAccent}</span></h1>
      </div>
      <p class="ab-hero-intro">{companyPurpose.introduction}</p>
    </div>
    <div class="ab-city" data-reveal>
      <svg class="ab-city-lines" viewBox="0 0 1200 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M0 260C200 220 320 300 520 270s380-120 680-80" />
        <path d="M0 200C220 160 360 240 560 210s360-110 640-70" />
        <path d="M0 140C240 100 380 180 600 150s340-100 600-60" />
        <path d="M0 80C260 40 400 120 640 90s320-90 560-50" />
        <path class="ab-city-route" d="M120 300C300 260 420 200 600 170" />
      </svg>
      <div class="ab-city-copy">
        <svg class="ab-city-pin" viewBox="0 0 24 30" aria-hidden="true"><path d="M12 1a8 8 0 0 0-8 8c0 6 8 16 8 16s8-10 8-16a8 8 0 0 0-8-8z" /><circle cx="12" cy="9" r="3" /></svg>
        <p><b>{hero.city}</b><span>{hero.region}</span></p>
      </div>
      <div class="ab-map">
        <svg class="ab-map-svg" viewBox="0 0 620 360" role="img" aria-labelledby="peru-map-title peru-map-description">
          <title id="peru-map-title">Perú con Cerro de Pasco resaltado</title>
          <desc id="peru-map-description">Silueta de Perú con un marcador aproximado en Cerro de Pasco, en la región Pasco.</desc>
          <defs><radialGradient id="peru-map-glow"><stop stop-color="#f5a524" stop-opacity=".62" /><stop offset="1" stop-color="#f5a524" stop-opacity="0" /></radialGradient></defs>
          <g data-map-art>
            <path d="M316.9 96.3 L299.9 95.5 297.4 98.1 281.9 101.4 260.4 113 259 121 254.2 126.9 256.1 136.1 244.7 141 244.8 148.2 239.8 151.4 247.6 166.7 258.1 177.1 254.1 184.4 266.6 185.4 273.7 194.5 290.3 195 305.8 184.9 304.5 210.8 313.1 212.8 323.7 209.8 340 237.3 336 243.1 335 255.1 334.7 269.6 327.3 278.1 330.7 284.4 326.4 290.2 334.5 304.5 322.6 322.9 317.5 331.6 307.8 336 289 326.2 287.3 319.2 250 302.1 216.2 283.4 201.7 272.9 193.9 258.8 197 253.9 181.1 231.5 162.5 200 144.7 166.1 137 158.3 131.1 145.7 116.4 134.6 103 127.7 109.1 120.1 100 103.8 105.9 91.9 120.9 81.1 123.1 88.2 117.7 92.3 118.2 98.5 126 97.2 133.6 99 141.5 107.6 152.2 100.6 155.7 89.1 167.3 74.2 189.9 67.5 210.5 49.7 216.3 38.6 213.7 25.6 218.7 24 231.2 32.1 237.2 40.1 246 44.5 257 62.4 271.1 64.5 281.4 60 288.2 63 299.5 61.5 314 69.5 301.8 86.9 307.4 87.3 316.9 96.3Z" fill="#6acbd0" fill-opacity=".86" stroke="#c8f5f4" stroke-width="2.5" stroke-linejoin="round" />
            <circle cx="197.1" cy="205.2" r="31" fill="url(#peru-map-glow)" /><circle cx="197.1" cy="205.2" r="12" fill="#f5a524" fill-opacity=".3" stroke="#ffd36c" stroke-width="2" /><circle cx="197.1" cy="205.2" r="5.5" fill="#f5a524" stroke="#fff" stroke-width="2.5" />
          </g>
          <path d="M207 205.2h162" fill="none" stroke="#fff" stroke-opacity=".82" stroke-width="2" /><circle cx="369" cy="205.2" r="4" fill="#f5a524" />
          <rect x="382" y="177" width="202" height="58" rx="17" fill="#fff" /><text x="400" y="201" fill="#218e97" font-size="11" font-family="Open Sans, sans-serif" font-weight="700" letter-spacing="1.5">ZONA WOKI</text><text x="400" y="221" fill="#0d2f34" font-size="15" font-family="Open Sans, sans-serif" font-weight="800">Cerro de Pasco</text>
        </svg>
      </div>
    </div>
  </div>
</section>
