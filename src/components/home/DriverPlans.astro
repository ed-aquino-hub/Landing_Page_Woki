---
import { Picture } from 'astro:assets';
import { driverPerks } from '../../data/home';
import { assets, brand, routes } from '../../data/site';
---
<section class="h-section h-drivers" id="conductores" aria-labelledby="h-drivers-title">
  <div class="wrap h-drivers-grid">
    <div class="h-drivers-media" data-reveal>
      <Picture
        src={assets.driverPhoto}
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 960]}
        sizes="(min-width: 960px) 46vw, 100vw"
        alt={`Conductor de Woki sonriendo al volante de su taxi en ${brand.city}`}
        loading="lazy"
        decoding="async"
        class="h-drivers-img"
      />
      <div class="h-drivers-stats" role="group" aria-label="Ejemplo de información en la app">
          <div class="h-driver-request"><small>Nueva solicitud</small><b>Plaza Chaupimarca</b><span>Destino · 0.8 km</span></div>
        <div class="h-driver-detail"><small>Tarifa visible</small><b>S/ 6.00</b><span>Pago en efectivo o Yape</span></div>
      </div>
    </div>
    <div class="h-drivers-copy">
      <header data-reveal>
        <p class="h-kicker is-light">Para conductores</p>
        <h2 id="h-drivers-title">Tu taxi, a tu manera.</h2>
        <p class="h-lead">Revisa cada solicitud antes de decidir y recibe el pago directo del pasajero.</p>
      </header>
      <ul class="h-perks" data-reveal style="--i:2" aria-label="Ventajas para conductores">
        {driverPerks.map((perk) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg>{perk}</li>)}
      </ul>
      <div class="h-drivers-actions" data-reveal style="--i:4">
        <a class="h-btn h-btn-aqua" href={routes.drivers} data-track="cta_click" data-track-label="quiero_ser_conductor" data-track-location="conductores">Quiero ser conductor Woki</a>
        <a class="h-link-light" href={`${routes.drivers}#registro-conductor`} data-track="cta_click" data-track-label="ver_requisitos" data-track-location="conductores">Ver requisitos</a>
      </div>
    </div>
  </div>
</section>
