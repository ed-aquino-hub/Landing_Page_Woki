---
import { Picture } from 'astro:assets';
import { driverPlans, driverPerks } from '../../data/home';
import { assets, brand, routes } from '../../data/site';
---
<section class="h-section h-drivers" id="conductores" aria-labelledby="h-drivers-title">
  <div class="wrap h-drivers-grid">
    <div class="h-drivers-media" data-reveal>
      <Picture
        src={assets.driverPhoto}
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 960]}
        sizes="(min-width: 960px) 46vw, 100vw"
        alt={`Conductor de Woki sonriendo al volante de su taxi en ${brand.city}`}
        loading="lazy"
        decoding="async"
        class="h-drivers-img"
      />
      <div class="h-drivers-stats" aria-hidden="true">
        <div><small>Ganado hoy</small><b>S/ <span data-count="42" data-dec="2">42.00</span></b></div>
        <div><small>Nueva solicitud</small><b class="h-sm">Plaza Chaupimarca</b><span>S/ 6.00 · 0.8 km</span></div>
      </div>
    </div>
    <div class="h-drivers-copy">
      <header data-reveal>
        <p class="h-kicker is-light">Para conductores</p>
        <h2 id="h-drivers-title">Tu taxi, tus horarios,<br />tu plan.</h2>
        <p class="h-lead">Conéctate cuando quieras, mira la tarifa y la distancia antes de aceptar, y cobra directo al pasajero.</p>
      </header>
      <div class="h-plans" id="planes">
        {driverPlans.map((plan, index) => (
          <article class:list={['h-plan', { 'is-featured': plan.featured }]} data-reveal style={`--i:${index + 1}`}>
            {plan.badge && <span class="h-plan-badge">{plan.badge}</span>}
            <h3>{plan.name}</h3>
            <p class="h-plan-price">{plan.price}</p>
            <p>{plan.description}</p>
          </article>
        ))}
      </div>
      <ul class="h-perks" data-reveal style="--i:3">
        {driverPerks.map((perk) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" /></svg>{perk}</li>)}
      </ul>
      <div class="h-drivers-actions" data-reveal style="--i:4">
        <a class="h-btn h-btn-aqua" href={routes.drivers} data-track="cta_click" data-track-label="quiero_ser_conductor" data-track-location="conductores">Quiero ser conductor Woki</a>
        <a class="h-link-light" href={`${routes.drivers}#registro-conductor`} data-track="cta_click" data-track-label="ver_requisitos" data-track-location="conductores">Ver requisitos</a>
      </div>
    </div>
  </div>
</section>
