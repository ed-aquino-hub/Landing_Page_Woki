---
import { safetyStages, homeDemoTrip } from '../../data/home';
import { brand, routes } from '../../data/site';
const pinDigits = [...brand.demoPin];
---
<section class="h-section h-safety" id="seguridad" aria-labelledby="h-safety-title">
  <div class="wrap">
    <header class="h-split-head" data-reveal>
      <div>
        <p class="h-kicker">Seguridad en cada etapa</p>
        <h2 id="h-safety-title">Compara los datos<br />antes de subir.</h2>
      </div>
      <p class="h-lead">La app muestra información para revisar el vehículo, confirmar el inicio y seguir el recorrido.</p>
    </header>
    <ol class="h-safety-grid">
      {safetyStages.map((stage, index) => (
        <li class:list={['h-safety-card', { 'is-accent': stage.visual === 'pin' }]} data-reveal style={`--i:${index}`}>
          <span class="h-safety-step">{String(index + 1).padStart(2, '0')} · {stage.step}</span>
          <h3>{stage.title}</h3>
          <p>{stage.description}</p>
          <div class:list={['h-safety-visual', { 'is-stars': stage.visual === 'stars' }]} aria-hidden="true">
            {stage.visual === 'plate' && <div class="h-vis-plate"><span>Toyota Yaris</span><b class="h-plate">{homeDemoTrip.driver.plate}</b></div>}
            {stage.visual === 'pin' && <div class="h-vis-pin">{pinDigits.map((digit) => <span>{digit}</span>)}</div>}
            {stage.visual === 'route' && <svg class="h-vis-route" viewBox="0 0 220 64"><rect width="220" height="64" rx="14" /><path d="M20 46C60 46 70 18 110 22s60 22 90-4" /><circle cx="20" cy="46" r="6" /><circle class="end" cx="200" cy="18" r="7" /></svg>}
            {stage.visual === 'stars' && <div class="h-vis-stars">★★★★★</div>}
          </div>
        </li>
      ))}
    </ol>
    <a class="h-btn h-btn-solid h-center" href={routes.safety} data-track="cta_click" data-track-label="ver_pasajero" data-track-location="seguridad">Ver más sobre pasajero</a>
  </div>
</section>
