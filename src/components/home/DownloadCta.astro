---
import StoreButtons from '../StoreButtons.astro';
import Taxi from '../Taxi.astro';
import { brand, routes } from '../../data/site';
const hasPlayUrl = Boolean(import.meta.env.PUBLIC_GOOGLE_PLAY_URL);
---
<section class="h-cta" id="descargar" aria-labelledby="h-cta-title">
  <div class="wrap">
    <div class="h-cta-box" data-reveal>
      <svg class="h-cta-pin" viewBox="0 0 24 30" aria-hidden="true"><path d="M12 1a8 8 0 0 0-8 8c0 6 8 16 8 16s8-10 8-16a8 8 0 0 0-8-8z" /><circle cx="12" cy="9" r="3" /></svg>
      <div class="h-cta-copy">
        <h2 id="h-cta-title">Muévete fácil y seguro<br />con Woki.</h2>
        <p>{hasPlayUrl ? `Descarga la app y pide tu primer viaje en ${brand.city}.` : 'Los enlaces oficiales para descargar Woki estarán disponibles cuando publiquemos la aplicación.'}</p>
      </div>
      <div class="h-cta-actions">
        <StoreButtons location="cta_final" />
        <a href={routes.drivers} data-track="cta_click" data-track-label="registro_conductor" data-track-location="cta_final">¿Eres conductor? Regístrate aquí</a>
      </div>
      <div class="road" aria-hidden="true"><Taxi /></div>
    </div>
  </div>
</section>
