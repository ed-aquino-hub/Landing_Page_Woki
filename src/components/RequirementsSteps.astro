---
interface Props { id: string; data: { title: string; subtitle: string; requirements: readonly string[]; steps: readonly { title: string; description: string }[] } }
const { id, data } = Astro.props;
---
<section class="requirements-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="requirements-heading"><p class="eyebrow dark">Empieza con claridad</p><h2 id={`${id}-title`}>{data.title}</h2><p>{data.subtitle}</p></header>
    <div class="requirements-layout">
      <div class="registration-panel"><p class="requirements-label">TU REGISTRO EN 3 PASOS</p><ol class="registration-steps">{data.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div>
      <div class="requirements-list"><div class="requirements-list-heading"><h3>Tenlos listos para registrarte</h3></div><ul>{data.requirements.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul></div>
    </div>
  </div>
</section>

<style>
  .requirements-section{padding:clamp(3rem,6vw,5rem) 0;background:linear-gradient(180deg,#f2f9fa,#fff)}
  .requirements-heading{max-width:760px;margin:0 auto 1.8rem;text-align:center}.requirements-heading .eyebrow{justify-content:center}.requirements-heading h2{margin:.45rem 0;color:var(--deep)}.requirements-heading>p:last-child{color:#45666b}
  .requirements-layout{display:grid;grid-template-columns:1fr;gap:1.6rem;max-width:1120px;margin:auto;align-items:stretch}
  .requirements-label{margin:0 0 .5rem;color:var(--cian);font-size:.75rem;font-weight:900;letter-spacing:.12em}
  .requirements-list{display:grid;grid-template-columns:1fr;align-items:center;gap:1.2rem;padding:clamp(1.4rem,3vw,2rem);border:1px solid color-mix(in srgb,var(--aqua) 55%,white);border-top:5px solid var(--cian);border-radius:var(--r-lg);background:linear-gradient(145deg,#075f68,#06464d);color:white;box-shadow:0 18px 40px color-mix(in srgb,var(--deep) 16%,transparent)}
  .requirements-list-heading{text-align:center}.requirements-list .requirements-label{color:var(--aqua)}.requirements-list h3{margin:0;color:white;font-size:clamp(1.35rem,2.2vw,1.7rem);line-height:1.2}
  .requirements-list ul{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.8rem;margin:0;padding:0;list-style:none}.requirements-list li{grid-column:span 2;display:flex;align-items:center;justify-content:center;gap:.6rem;min-height:3.5rem;padding:.7rem .8rem;border:1px solid color-mix(in srgb,var(--aqua) 42%,transparent);border-radius:14px;background:color-mix(in srgb,var(--deep) 35%,transparent);color:#f2ffff;font-size:clamp(.95rem,1.08vw,1.05rem);font-weight:800;line-height:1.3;text-align:center}.requirements-list li:nth-child(4){grid-column:2 / span 2}.requirements-list li:nth-child(5){grid-column:4 / span 2}.requirements-list li span{display:grid;place-items:center;width:1.55rem;height:1.55rem;flex:none;border-radius:50%;background:var(--aqua);color:var(--deep);font-weight:900;font-size:.85rem}
  .registration-panel{padding:0;border:0;background:transparent;box-shadow:none}.registration-panel>.requirements-label{margin-bottom:.8rem;text-align:center;font-size:.8rem}
  .registration-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:0;padding:0;list-style:none}
  .registration-steps li{position:relative;display:grid;grid-template-columns:2.7rem minmax(0,1fr);column-gap:.85rem;row-gap:.55rem;align-content:start;min-height:8.5rem;padding:1.1rem 1.2rem;border:1px solid #b9dfe4;border-top:4px solid var(--cian);border-radius:var(--r-md);background:#fff;box-shadow:0 12px 28px color-mix(in srgb,var(--deep) 9%,transparent)}
  .registration-steps li>span{display:grid;place-items:center;width:2.7rem;height:2.7rem;border:3px solid white;border-radius:50%;background:var(--cian);color:white;font-size:.95rem;font-weight:900;box-shadow:0 0 0 1px color-mix(in srgb,var(--cian) 35%,white)}
  .registration-steps li>div{display:contents}.registration-steps h3{align-self:center;margin:0;color:var(--deep);font-size:1.2rem;line-height:1.3}.registration-steps p{grid-column:1/-1;width:100%;margin:0;color:#365d62;font-size:1.02rem;line-height:1.5}
  @media(max-width:900px){.requirements-list ul{grid-template-columns:repeat(6,minmax(0,1fr))}}
  @media(max-width:760px){.requirements-list{grid-template-columns:1fr;gap:.75rem}.requirements-list ul{grid-template-columns:repeat(6,minmax(0,1fr))}.registration-steps{grid-template-columns:repeat(3,minmax(0,1fr))}.registration-steps li{min-height:8rem;padding:1rem}}
  @media(max-width:600px){.registration-steps{grid-template-columns:1fr}.registration-steps li{min-height:0}}
  @media(max-width:600px){.requirements-list ul{grid-template-columns:repeat(2,minmax(0,1fr))}.requirements-list li{grid-column:auto}.requirements-list li:nth-child(4),.requirements-list li:nth-child(5){grid-column:auto}}
  @media(max-width:360px){.requirements-list ul{grid-template-columns:1fr}}
</style>
