---
import Logo from './Logo.astro';
import { navigation, headerActions, routes } from '../data/site';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && currentPath === href;
---
<header class:list={['top', { scrolled: solid }]} data-solid={solid ? '' : undefined}>
  <div class="bar">
    <a href={routes.home} aria-label="Woki, inicio"><Logo /></a>
    <nav id="menu" aria-label="Navegación principal">
      {navigation.map((item) => (
        <a href={item.href} data-section={item.section} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-cta-mobile" href={headerActions.driver.href} data-track="cta_click" data-track-label="quiero_conducir" data-track-location="menu_movil">{headerActions.driver.label}</a>
    </nav>
    <div class="bar-actions">
      <a class="pide-ghost" href={headerActions.driver.href} data-track="cta_click" data-track-label="quiero_conducir" data-track-location="header">{headerActions.driver.label}</a>
      <a class="pide" href={headerActions.download.href} data-track="cta_click" data-track-label="descargar_app" data-track-location="header">
        {headerActions.download.label}
        <span class="arr" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4l4 4-4 4"/></svg></span>
      </a>
    </div>
    <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
  </div>
</header>
{!solid && <div class="scroll-progress" aria-hidden="true"><span></span></div>}
