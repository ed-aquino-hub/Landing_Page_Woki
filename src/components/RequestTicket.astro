---
interface Props { id: string; data: { title: string; subtitle: string; tag: string; rows: readonly { label: string; value: string }[]; noteTitle: string; note: string } }
const { id, data } = Astro.props;
---
<section class="ticket-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="ticket-heading"><p class="eyebrow dark">Antes de aceptar</p><h2 id={`${id}-title`}>{data.title}</h2><p>{data.subtitle}</p></header>
    <div class="ticket-layout">
      <article class="ticket-card" aria-label={data.tag}>
        <div class="ticket-top"><span>{data.tag}</span><b aria-hidden="true">Woki</b></div>
        <dl>{data.rows.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
        <p class="ticket-foot">Los datos son ilustrativos y pueden variar según la solicitud.</p>
      </article>
      <aside class="ticket-note"><span class="ticket-note-icon" aria-hidden="true">✓</span><h3>{data.noteTitle}</h3><p>{data.note}</p><span class="ticket-route" aria-hidden="true"><i></i><i></i><i></i></span></aside>
    </div>
  </div>
</section>

<style>
  .ticket-section{padding:clamp(3rem,6vw,5rem) 0;background:linear-gradient(180deg,var(--paper),#fff)}
  .ticket-heading{max-width:760px;margin:0 auto 1.7rem;text-align:center}
  .ticket-heading .eyebrow{justify-content:center}.ticket-heading h2{margin:.45rem 0;color:var(--deep)}
  .ticket-heading>p:last-child{color:#45666b}
  .ticket-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(250px,.9fr);align-items:center;gap:clamp(1.2rem,4vw,3rem);max-width:900px;margin:auto}
  .ticket-card{overflow:hidden;border:1px solid color-mix(in srgb,var(--cian) 24%,white);border-radius:var(--r-lg);background:#fff;box-shadow:0 22px 55px color-mix(in srgb,var(--deep) 12%,transparent)}
  .ticket-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;background:var(--deep);color:white}
  .ticket-top span{padding:.3rem .6rem;border-radius:999px;background:color-mix(in srgb,var(--aqua) 16%,transparent);color:var(--aqua);font-size:.73rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}
  .ticket-top b{font-size:1.2rem}
  .ticket-card dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;padding:.5rem 1.1rem}
  .ticket-card dl>div{padding:.8rem .5rem;border-bottom:1px dashed color-mix(in srgb,var(--cian) 22%,white)}
  .ticket-card dl>div:nth-last-child(-n+2){border-bottom:0}
  .ticket-card dt{color:#5f7d81;font-size:.82rem}.ticket-card dd{margin:.12rem 0 0;color:var(--deep);font-weight:800}
  .ticket-foot{margin:0;padding:.75rem 1.25rem 1.1rem;color:#607c80;font-size:.78rem}
  .ticket-note{position:relative;overflow:hidden;padding:clamp(1.4rem,3vw,2rem);border:1px solid color-mix(in srgb,var(--cian) 20%,white);border-radius:var(--r-lg);background:#fff;box-shadow:0 14px 34px color-mix(in srgb,var(--deep) 7%,transparent)}
  .ticket-note-icon{display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:50%;background:var(--aqua);color:var(--deep);font-weight:900}
  .ticket-note h3{margin:1rem 0 .5rem;color:var(--deep);font-size:1.35rem}.ticket-note p{position:relative;z-index:1;color:#45666b;line-height:1.65}
  .ticket-route{display:flex;align-items:center;justify-content:space-between;width:100%;height:3px;margin-top:1.4rem;background:repeating-linear-gradient(90deg,var(--cian) 0 8px,transparent 8px 15px)}
  .ticket-route i{width:10px;height:10px;border:2px solid white;border-radius:50%;background:var(--pin);box-shadow:0 0 0 2px var(--cian)}
  @media(max-width:700px){.ticket-layout{grid-template-columns:1fr}.ticket-card dl{grid-template-columns:1fr 1fr}}
  @media(max-width:420px){.ticket-card dl{grid-template-columns:1fr}.ticket-card dl>div:nth-last-child(2){border-bottom:1px dashed color-mix(in srgb,var(--cian) 22%,white)}}
</style>
