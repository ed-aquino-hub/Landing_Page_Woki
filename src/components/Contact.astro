---
import { contacto } from '../data/content';
const contactFormEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
const whatsappHref = `https://wa.me/${contacto.whatsapp.replace(/\D/g, '')}`;
---
<section class="contact" id="contacto" aria-labelledby="h-contact">
  <div class="wrap contact-grid">
    <div data-reveal>
      <p class="eyebrow dark">Contacto</p>
      <h2 id="h-contact">Hablemos, estamos para ayudarte</h2>
      <p class="lead">¿Tienes una duda, una sugerencia o quieres manejar con Woki? Consulta las opciones de contacto y los próximos pasos disponibles.</p>
      <div class="contact-list">
        <a href={`mailto:${contacto.email}`}><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg></span><span><b>Soporte</b><span>{contacto.email}</span></span></a>
        <a href={`mailto:${contacto.legalEmail}`}><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg></span><span><b>Consultas legales y privacidad</b><span>{contacto.legalEmail}</span></span></a>
        <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11zM12 10m-2.5 0a2.5 2.5 0 105 0 2.5 2.5 0 10-5 0" /></svg></span><span><b>Ubicación</b><span>{contacto.ubicacion}</span></span></div>
        {contacto.whatsappIsTemporary ? <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.2 11.6a8.2 8.2 0 01-12.1 7.2L3 20l1.2-5a8.2 8.2 0 1116-3.4z" /><path d="M8.2 7.8c-.5.4-.8 1-.7 1.7.2 1.1 1 2.6 2.3 3.9 1.3 1.3 2.8 2.1 3.9 2.3.7.1 1.3-.2 1.7-.7l.5-.7-2.2-1.2-1 1c-.7-.3-1.4-.8-2-1.4-.6-.6-1.1-1.3-1.4-2l1-1-1.2-2.2-.9.3z" /></svg></span><span><b>WhatsApp</b><span>Muy pronto</span></span></div> : <a href={whatsappHref} target="_blank" rel="noopener noreferrer"><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.2 11.6a8.2 8.2 0 01-12.1 7.2L3 20l1.2-5a8.2 8.2 0 1116-3.4z" /><path d="M8.2 7.8c-.5.4-.8 1-.7 1.7.2 1.1 1 2.6 2.3 3.9 1.3 1.3 2.8 2.1 3.9 2.3.7.1 1.3-.2 1.7-.7l.5-.7-2.2-1.2-1 1c-.7-.3-1.4-.8-2-1.4-.6-.6-1.1-1.3-1.4-2l1-1-1.2-2.2-.9.3z" /></svg></span><span><b>WhatsApp</b><span>{contacto.whatsapp}</span></span></a>}
      </div>
    </div>
    <form class="form contact-form" data-contact-form data-endpoint={contactFormEndpoint ?? ''} data-reveal novalidate>
      <h2>Cuéntanos en qué podemos ayudarte</h2>
      <p class="form-intro">Usaremos tu nombre, medio de contacto y mensaje únicamente para responder esta consulta. Revisa la <a href="/privacidad">Política de Privacidad</a>.</p>
      <label>Nombre<input name="nombre" type="text" autocomplete="name" placeholder="Tu nombre" data-contact-field="nombre" data-default-placeholder="Tu nombre" aria-describedby="error-nombre" required /><small class="field-error" id="error-nombre" data-field-error="nombre" role="alert" hidden></small></label>
      <label>Correo o teléfono<input name="contacto" type="text" autocomplete="email" placeholder="¿Cómo te contactamos?" data-contact-field="contacto" data-default-placeholder="¿Cómo te contactamos?" aria-describedby="error-contacto" required /><small class="field-error" id="error-contacto" data-field-error="contacto" role="alert" hidden></small></label>
      <label>¿Sobre qué nos escribes?
        <select name="motivo" data-contact-field="motivo" aria-describedby="error-motivo" required>
          <option value="" selected disabled>Elige una opción</option>
          <option>Soy pasajero</option>
          <option>Quiero ser conductor</option>
          <option>Alianzas o prensa</option>
          <option>Otro</option>
        </select>
        <small class="field-error" id="error-motivo" data-field-error="motivo" role="alert" hidden></small>
      </label>
      <label>Mensaje<textarea name="mensaje" placeholder="Escribe aquí tu consulta" data-contact-field="mensaje" data-default-placeholder="Escribe aquí tu consulta" aria-describedby="error-mensaje" required></textarea><small class="field-error" id="error-mensaje" data-field-error="mensaje" role="alert" hidden></small></label>
      <label class="hp" aria-hidden="true">No completar<input name="website" tabindex="-1" autocomplete="off" /></label>
      <div class="contact-consent"><label class="check"><input type="checkbox" name="consentimiento" data-contact-field="consentimiento" aria-describedby="error-consentimiento" required /><span>Acepto que Woki App trate mis datos para responder esta consulta. Consulta la <a href="/privacidad">Política de Privacidad</a>.</span></label><small class="field-error" id="error-consentimiento" data-field-error="consentimiento" role="alert" hidden></small></div>
      {!contactFormEndpoint && <p class="form-intro" id="contact-form-unavailable">El envío desde esta página aún no está conectado. Si completaste el formulario, puedes escribirnos a <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.</p>}
      <button class="btn solid" type="submit" aria-describedby={!contactFormEndpoint ? 'contact-form-unavailable' : undefined}>Enviar mensaje</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
