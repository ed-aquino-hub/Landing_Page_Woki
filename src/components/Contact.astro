---
// Formulario con envío propio y validación Cloudflare Turnstile.
import { contacto } from '../data/content';
import { contactPage } from '../data/pages';
import { routes } from '../data/site';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const { needs, channels, form } = contactPage;
const location = 'contacto_canales';
---
<section class="ct-main" id="contacto" aria-labelledby="ct-form-title">
  <div class="wrap ct-grid">
    <div class="ct-aside">
      <nav class="ct-card" aria-labelledby="ct-needs-title" data-reveal>
        <h2 id="ct-needs-title">{needs.title}</h2>
        <ul class="ct-needs">
          {needs.items.map((item) => (
            <li><a href={item.href} data-track="cta_click" data-track-label={item.track} data-track-location="contacto_que_necesitas">{item.label}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </nav>
      <ul class="ct-channels" aria-label="Canales de contacto" data-reveal style="--i:1">
        <li><a href={`mailto:${contacto.email}`} data-track="contact_click" data-track-label="email_soporte" data-track-location={location}><span class="ct-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg></span><span><small>{channels.support}</small><b>{contacto.email}</b></span></a></li>
        <li><a href={`mailto:${contacto.legalEmail}`} data-track="contact_click" data-track-label="email_legal" data-track-location={location}><span class="ct-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg></span><span><small>{channels.legal}</small><b>{contacto.legalEmail}</b></span></a></li>
        <li><span class="ct-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span><span><small>{channels.location}</small><b>{contacto.ubicacion}</b></span></li>
      </ul>
    </div>

    <form class="form ct-form" data-contact-form data-endpoint="/api/contact" data-form-ready={turnstileSiteKey ? 'true' : 'false'} data-reveal style="--i:1" novalidate>
      <div>
        <h2 id="ct-form-title">{form.title}</h2>
        <p class="form-intro">{form.intro} <a href={routes.privacy}>Política de Privacidad</a>.</p>
      </div>
      <div class="ct-row">
        <label>Nombre<input name="nombre" type="text" autocomplete="name" placeholder="Tu nombre" data-contact-field="nombre" data-default-placeholder="Tu nombre" aria-describedby="error-nombre" required /><small class="field-error" id="error-nombre" data-field-error="nombre" role="alert" hidden></small></label>
        <label>Correo electrónico<input name="contacto" type="email" autocomplete="email" placeholder="nombre@correo.com" data-contact-field="contacto" data-default-placeholder="nombre@correo.com" aria-describedby="error-contacto" required /><small class="field-error" id="error-contacto" data-field-error="contacto" role="alert" hidden></small></label>
      </div>
      <label>Mensaje<textarea name="mensaje" placeholder="Escribe aquí tu consulta" data-contact-field="mensaje" data-default-placeholder="Escribe aquí tu consulta" aria-describedby="error-mensaje" required></textarea><small class="field-error" id="error-mensaje" data-field-error="mensaje" role="alert" hidden></small></label>
      <label class="hp" aria-hidden="true">No completar<input name="website" tabindex="-1" autocomplete="off" /></label>
      {turnstileSiteKey
        ? <div class="ct-captcha"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-language="es"></div></div>
        : <p class="ct-captcha-note" role="status">Estamos activando la validación del formulario. Mientras tanto, escríbenos a <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.</p>}
      <div class="contact-consent"><label class="check"><input type="checkbox" name="consentimiento" data-contact-field="consentimiento" aria-describedby="error-consentimiento" required /><span>{form.consent}</span></label><small class="field-error" id="error-consentimiento" data-field-error="consentimiento" role="alert" hidden></small></div>
      <button class="p-btn p-btn-solid" type="submit" disabled={!turnstileSiteKey}>{form.submitEndpoint}</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
