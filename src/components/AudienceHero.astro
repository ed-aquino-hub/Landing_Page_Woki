---
import { Picture } from 'astro:assets';
import TopographicBackdrop from './TopographicBackdrop.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  action: string;
  actionHref: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, title, description, action, actionHref, image, imageAlt } = Astro.props;
---

<section class="subpage-hero detail-hero audience-hero">
  <TopographicBackdrop city />
  <div class="wrap audience-hero-grid">
    <div class="audience-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <a class="btn solid audience-hero-cta" href={actionHref}>{action}</a>
    </div>
    <div class="audience-hero-visual">
      <Picture src={image} formats={['avif', 'webp']} widths={[360, 540, 720, 960, 1200]} sizes="(min-width: 1000px) 46vw, 100vw" alt={imageAlt} loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>

<style>
  .audience-hero{position:relative;isolation:isolate;min-height:0;padding:7rem 0 2.75rem;overflow:hidden;background:linear-gradient(125deg,var(--deep),var(--ink));color:#fff}
  .audience-hero>.wrap{position:relative;z-index:1;display:grid;width:min(calc(100% - 2.5rem),var(--max));grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center;gap:clamp(2rem,6vw,6rem);margin-inline:auto}
  .audience-hero-copy{max-width:560px}
  .audience-hero-copy h1{max-width:12ch;color:#fff;font-size:clamp(2.45rem,4.5vw,3.8rem);line-height:1.02;text-wrap:balance}
  .audience-hero-copy .eyebrow{color:var(--aqua)}
  .audience-hero-copy .lead{max-width:50ch;color:var(--paper);font-size:1.1rem;line-height:1.65}
  .audience-hero-cta{margin-top:.35rem}
  .audience-hero-visual{position:relative;min-width:0;aspect-ratio:1.65;isolation:isolate}
  .audience-hero-visual::before{position:absolute;z-index:-1;inset:-7%;border:1px solid color-mix(in srgb,var(--aqua) 30%,transparent);border-radius:50%;box-shadow:0 0 0 20px color-mix(in srgb,var(--aqua) 5%,transparent),0 0 0 48px color-mix(in srgb,var(--aqua) 3%,transparent);content:""}
  .audience-hero-visual picture,.audience-hero-visual img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center;border-radius:47% 53% 42% 58% / 46% 40% 60% 54%}
  .audience-hero-visual img{box-shadow:0 28px 72px color-mix(in srgb,var(--ink) 42%,transparent)}
  @media(max-width:950px){.audience-hero{padding:7rem 0 2.5rem}.audience-hero>.wrap{grid-template-columns:1fr minmax(0,.9fr);gap:1.5rem}.audience-hero-copy{max-width:700px}.audience-hero-visual{width:100%;margin-inline:auto;aspect-ratio:1.35}}
  @media(max-width:620px){.audience-hero{padding:6.5rem 0 2rem}.audience-hero>.wrap{width:calc(100% - 2rem);grid-template-columns:1fr;gap:1.4rem}.audience-hero-copy h1{font-size:clamp(2.5rem,12vw,3.5rem)}.audience-hero-copy .lead{font-size:1rem}.audience-hero-visual{aspect-ratio:1.3}.audience-hero-visual picture,.audience-hero-visual img{border-radius:30px;object-position:center 38%}}
</style>
