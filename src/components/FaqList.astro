---
import type { QuestionItem } from '../data/content';
interface Props { id: string; items: QuestionItem[]; subtitle?: string }
const { id, items, subtitle = 'Encuentra respuestas rápidas para continuar tu recorrido.' } = Astro.props;
---
<section class="faq-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class="faq-heading"><p class="eyebrow dark">Respuestas claras</p><h2 id={`${id}-title`}>Preguntas frecuentes</h2><p>{subtitle}</p></header>
    <div class="faq-list">{items.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </div>
</section>

<style>
  .faq-section{padding:clamp(3rem,6vw,5rem) 0;background:#fff}
  .faq-heading{max-width:760px;margin:0 auto 1.6rem;text-align:center}.faq-heading .eyebrow{justify-content:center}.faq-heading h2{margin:.4rem 0;color:var(--deep)}.faq-heading>p:last-child{color:#45666b}
  .faq-list{max-width:880px;margin:auto}
  .faq-list details{margin:.7rem 0;padding:1rem 1.2rem;border:1px solid color-mix(in srgb,var(--cian) 24%,white);border-left:4px solid var(--pin);border-radius:var(--r-md);background:var(--paper);box-shadow:0 8px 22px color-mix(in srgb,var(--deep) 5%,transparent)}
  .faq-list summary{align-items:center;color:var(--deep);font-weight:800;cursor:pointer}.faq-list summary::after{content:'+';color:var(--cian);font-size:1.35rem}.faq-list details[open] summary::after{content:'−'}.faq-list details p{margin-top:.7rem;color:#45666b;line-height:1.6}
  @media(max-width:520px){.faq-list details{padding:.85rem 1rem}}
</style>
