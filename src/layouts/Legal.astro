---
// Plantilla común de los documentos legales (Legal.html): hero con ruta de
// navegación, selector de documentos, índice generado a partir de los <h2>
// del documento y cuerpo con numeración destacada.
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { legalPage } from '../data/pages';
import { assets, brand, legalNavigation } from '../data/site';
import '../styles/pages.css';
import '../styles/legal.css';

interface Props { title: string; description: string; updated?: string; imageAlt?: string }
const { title, description, updated = brand.legalUpdated } = Astro.props;
const base = Astro.site ?? new URL(brand.siteUrl);
const pagePath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: base.href }, { '@type': 'ListItem', position: 2, name: title, item: new URL(pagePath, base).href }] };

const slugify = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '').trim();

// Cada <h2> recibe un id (si no lo tiene) y su número "1." pasa a un indicador visual "01".
const toc: { id: string; label: string }[] = [];
const rawBody = await Astro.slots.render('default');
const body = rawBody.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_match, attrs: string, inner: string) => {
  const numbered = stripTags(inner).match(/^(\d+)\.\s*(.+)$/);
  const label = numbered ? numbered[2] : stripTags(inner);
  const existingId = attrs.match(/\bid="([^"]+)"/)?.[1];
  const id = existingId ?? slugify(label);
  toc.push({ id, label });
  const content = numbered ? `<span class="lg-num" aria-hidden="true">${numbered[1].padStart(2, '0')}</span>${inner.replace(/^\s*\d+\.\s*/, '')}` : inner;
  return `<h2${existingId ? attrs : `${attrs} id="${id}"`}>${content}</h2>`;
}).replace(/<a href="mailto:([^"@]+)@[^"]+"(?![^>]*data-track)/g, (match, user: string) => `${match} data-track="contact_click" data-track-label="email_${user}" data-track-location="legal_documento"`);
---
<Layout title={`${title} | ${brand.name}`} description={description} image={assets.socialImage} imageAlt={Astro.props.imageAlt ?? `Información sobre ${title.toLowerCase()} de Woki`}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  <Header solid />
  <main id="main-content" class="page lg-page">
    <section class="lg-hero" aria-labelledby="lg-title">
      <div class="wrap">
        <Breadcrumbs current={title} />
        <p class="p-kicker">{legalPage.eyebrow}</p>
        <h1 id="lg-title">{title}</h1>
        <p class="p-lead">{legalPage.lead}</p>
      </div>
    </section>
    <div class="wrap lg-layout">
      <aside class="lg-aside">
        <nav class="lg-docs" aria-labelledby="lg-docs-title">
          <p class="lg-docs-title" id="lg-docs-title">{legalPage.navTitle}</p>
          <ul>
            {legalNavigation.map(({ href, label }) => <li><a href={href} aria-current={pagePath === href ? 'page' : undefined}>{label}</a></li>)}
          </ul>
        </nav>
        <div class="lg-help">
          <p><b>{legalPage.help.title}</b>{legalPage.help.text}</p>
          <a href={`mailto:${brand.legalEmail}`} data-track="contact_click" data-track-label="email_legal" data-track-location="legal_ayuda">{brand.legalEmail}</a>
        </div>
      </aside>
      <article class="lg-doc" aria-labelledby="lg-title">
        <p class="lg-updated">{legalPage.updatedLabel} {updated}</p>
        {toc.length > 1 && (
          <nav class="lg-toc" aria-labelledby="lg-toc-title">
            <p id="lg-toc-title">{legalPage.tocTitle}</p>
            <ol>{toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
          </nav>
        )}
        <div class="lg-body" set:html={body} />
      </article>
    </div>
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
